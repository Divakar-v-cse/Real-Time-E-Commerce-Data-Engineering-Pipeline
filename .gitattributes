# Normalise line endings so the repository is identical on every platform.
* text=auto eol=lf

# Explicit text types
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.txt     text eol=lf

# Windows scripts keep CRLF
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.parquet binary
*.pyc     binary
