# ---------------------------------------------------------------------------
# Divakar — Real-Time E-Commerce Data Engineering Pipeline
# Environment template. Copy to `.env` and adjust as needed.
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
#
# The real `.env` is git-ignored. Never commit credentials.
# Every variable below is optional — the application has working defaults.
# ---------------------------------------------------------------------------

# --- Warehouse -------------------------------------------------------------
# SQLAlchemy URL for PostgreSQL.
# Resolution order in common/settings.py:
#   1. DATABASE_URL (this variable)
#   2. .state/pg.json  — written automatically by scripts/pg_server.py
#   3. the docker-compose default shown below
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce

# --- Application -----------------------------------------------------------
LOG_LEVEL=INFO

# --- Event bus -------------------------------------------------------------
# Default is the built-in Kafka-compatible on-disk broker (no Kafka required).
# Set USE_REAL_KAFKA=true to publish through kafka-python instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
USE_REAL_KAFKA=false

# --- Object storage / lake -------------------------------------------------
MINIO_ENDPOINT=localhost:9000
LAKE_BUCKET=ecommerce-lake

# --- Streaming -------------------------------------------------------------
# Watermark tolerance for late-arriving events, in days.
LATE_TOLERANCE_DAYS=5
